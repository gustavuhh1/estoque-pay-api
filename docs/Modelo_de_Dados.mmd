    ESTABELECIMENTO {
        string id PK
        string nome
        string cnpj UK
        string ie
        string certificado_a1
        string certificado_a1_senha "criptografada"
        boolean emite_nfce "switch fiscal"
        int nfce_ultimo_numero "contador da NFC-e simulada"
        datetime criado_em
    }
    ASSINATURA {
        string id PK
        string estabelecimento_id FK,UK
        string abacatepay_sub_id UK
        string abacatepay_customer_id
        string metodo_pagamento_id "token, nunca o cartão"
        enum status "TRIALING|ACTIVE|PAST_DUE|CANCELED"
        enum tipo_plano "MENSAL|ANUAL"
        datetime trial_expira_em
        datetime periodo_atual_fim
        datetime criado_em
        datetime atualizado_em
    }
    USER {
        string id PK
        string name
        string email UK
        boolean emailVerified
        string image
        datetime createdAt
        datetime updatedAt
    }
    MEMBRO_ESTABELECIMENTO {
        string id PK
        string userId FK
        string estabelecimentoId FK
        enum role "ADMIN|OWNER|MANAGER|CASHIER"
        datetime createdAt
        datetime updatedAt
    }
    CONVITE_FUNCIONARIO {
        string id PK
        string email
        string estabelecimentoId FK
        enum role "ADMIN|OWNER|MANAGER|CASHIER"
        string criadoPorId FK
        datetime createdAt
        datetime aceitoEm
    }
    SESSION {
        string id PK
        datetime expiresAt
        string token UK
        string ipAddress
        string userAgent
        string userId FK
        datetime createdAt
        datetime updatedAt
    }
    ACCOUNT {
        string id PK
        string accountId
        string providerId
        string userId FK
        string password
        string issuer
        datetime createdAt
        datetime updatedAt
    }
    VERIFICATION {
        string id PK
        string identifier
        string value
        datetime expiresAt
    }
    CLIENTE {
        string id PK
        string estabelecimento_id FK
        string nome
        string cpf "único por loja"
        string telefone "Premium"
        datetime data_nascimento "Premium"
        string observacao "Premium"
        int pontos_fidelidade
        datetime criado_em
        datetime atualizado_em
    }
    CUPOM {
        string id PK
        string estabelecimento_id FK
        string cliente_id FK "nulo = cupom genérico da loja"
        string codigo "único por loja"
        decimal valor_desconto
        datetime expira_em
        datetime resgatado_em
        string venda_id FK,UK
        datetime criado_em
    }
    PRODUTO {
        string id PK
        string estabelecimento_id FK
        string nome
        string ean_gtin "único por loja"
        enum tipo_medida "UNIDADE|FRACIONADO_KG"
        decimal preco_custo
        decimal preco_venda
        decimal quantidade_atual "3 casas"
        decimal quantidade_minima "3 casas"
        string ncm "obrigatório só com NFC-e ligada"
        string cfop "obrigatório só com NFC-e ligada"
        boolean ativo
        datetime deletado_em "exclusão de produto já vendido"
        datetime criado_em
        datetime atualizado_em
    }
    CATEGORIA {
        string id PK
        string estabelecimento_id FK
        string nome "único por loja"
        datetime criado_em
        datetime atualizado_em
    }
    MOVIMENTACAO_ESTOQUE {
        string id PK
        string estabelecimento_id FK
        string produto_id FK
        string usuario_id FK
        decimal quantidade
        enum tipo "ENTRADA|SAIDA"
        enum motivo "REABASTECIMENTO|VENDA|ESTORNO_VENDA|DESCARTE|PERDA|VENCIMENTO|AJUSTE_MANUAL"
        string observacao
        datetime criado_em
    }
    TURNO_CAIXA {
        string id PK
        string estabelecimento_id FK "um ABERTO por loja"
        string aberto_por_id FK "qualquer cargo"
        string fechado_por_id FK "qualquer cargo"
        decimal valor_abertura
        decimal valor_fechamento
        enum status "ABERTO|FECHADO"
        datetime aberto_em
        datetime fechado_em
    }
    VENDA {
        string id PK
        string estabelecimento_id FK
        string usuario_id FK
        string cliente_id FK
        string turno_id FK
        decimal total_venda "itens - cupom, sem a taxa"
        enum metodo_pagamento "PIX_ABACATEPAY|DINHEIRO|DEBITO|CREDITO"
        enum status_pagamento "PENDENTE|PAGO|CANCELADO"
        string abacatepay_payment_id UK
        decimal taxa_split "R$ 0,80 pago pelo consumidor, só Pix"
        datetime pago_em
        enum nfe_status "PROCESSANDO|AUTORIZADA|ERRO"
        string nfe_url_pdf "não usado (D3)"
        string nfe_url_xml "não usado (D3)"
        int nfe_numero "único por loja"
        json nfe_espelho "NFC-e simulada"
        string chave_de_acesso "fictícia"
        string nfe_erro_mensagem
        int nfe_tentativas
        datetime nfe_enviada_em
        datetime cancelada_em
        string cancelada_por_id FK
        datetime criada_em
        datetime atualizada_em
    }
    ITEM_VENDA {
        string id PK
        string venda_id FK
        string produto_id FK
        decimal quantidade
        decimal preco_unitario
        decimal subtotal
    }
