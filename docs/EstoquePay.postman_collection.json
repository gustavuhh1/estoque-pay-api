                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ownerEmail2', 'dono2-' + Date.now() + '@email.com');",
                  "pm.collectionVariables.set('ownerPassword2', 'password123');",
                  "",
                  "function digitoVerificador(digitos, pesos) {",
                  "  var soma = pesos.reduce(function (acc, peso, i) { return acc + peso * digitos[i]; }, 0);",
                  "  var resto = soma % 11;",
                  "  return resto < 2 ? 0 : 11 - resto;",
                  "}",
                  "",
                  "var raiz = [];",
                  "for (var i = 0; i < 8; i++) raiz.push(Math.floor(Math.random() * 10));",
                  "",
                  "var base = raiz.concat([0, 0, 0, 1]);",
                  "var dv1 = digitoVerificador(base, [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]);",
                  "var dv2 = digitoVerificador(base.concat(dv1), [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]);",
                  "pm.collectionVariables.set('cnpj2', base.concat(dv1, dv2).join(''));"
                ]
              }
