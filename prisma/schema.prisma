generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum Plano {
  FREE
  PREMIUM
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  CASHIER
}

enum TipoMedida {
  UNIDADE
  FRACIONADO_KG
}

enum StatusTurno {
  ABERTO
  FECHADO
}

enum MetodoPagamento {
  PIX_ABACATEPAY
  DINHEIRO
  DEBITO
  CREDITO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  CANCELADO
}

enum NfeStatus {
  PROCESSANDO
  AUTORIZADA
  ERRO
}

// Novos Enums para Auditoria de Estoque

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum MotivoMovimentacao {
  REABASTECIMENTO
  VENDA
  ESTORNO_VENDA
  DESCARTE
  PERDA
  VENCIMENTO
  AJUSTE_MANUAL
}

// ================= MODELS (TABELAS) =================

// Módulo: Configurações & IAM

model Estabelecimento {
  id             String   @id @default(uuid())
  nome           String
  cnpj           String   @unique
  ie             String? // Inscrição Estadual
  certificado_a1 String? // URL/Caminho do certificado
  plano          Plano    @default(FREE)
  criado_em      DateTime @default(now())

  // Relacionamentos
  clientes   Cliente[]
  produtos   Produto[]
  categorias Categoria[]
  turnos     TurnoCaixa[]
  vendas     Venda[]
  membros    MembroEstabelecimento[]

  @@map("estabelecimentos")
}

model User {
  id            String    @id
  name          String?
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  estabelecimentos MembroEstabelecimento[]

  turnos        TurnoCaixa[]
  vendas        Venda[]
  movimentacoes MovimentacaoEstoque[] // Relacionamento com a auditoria de estoque

  @@unique([email])
  @@map("user")
}

model MembroEstabelecimento {
  id                String @id @default(uuid())
  userId            String
  estabelecimentoId String

  role      Role      @default(CASHIER) // O cargo fica aqui!
  updatedAt DateTime? @updatedAt
  createdAt DateTime? @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  // Garante que a mesma pessoa não seja vinculada duas vezes à mesma loja
  @@unique([userId, estabelecimentoId])
  @@index([userId])
  @@index([estabelecimentoId])
  @@map("membros_estabelecimento")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Módulo: CRM

model Cliente {
  id                 String    @id @default(uuid())
  estabelecimento_id String
  nome               String
  cpf                String    @unique
  telefone           String?
  data_nascimento    DateTime?
  observacao         String?
  pontos_fidelidade  Int       @default(0)

  estabelecimento Estabelecimento @relation(fields: [estabelecimento_id], references: [id])
  vendas          Venda[]

  @@map("clientes")
}

// Módulo: Estoque

model Produto {
  id                 String     @id @default(uuid())
  estabelecimento_id String
  nome               String
  ean_gtin           String? // Código de barras
  tipo_medida        TipoMedida @default(UNIDADE)
  preco_custo        Decimal // Para trava anti-prejuízo e inteligência financeira
  preco_venda        Decimal
  quantidade_atual   Decimal // Aceita decimais para fracionados
  quantidade_minima  Decimal    @default(0)
  ncm                String?
  cfop               String?
  ativo              Boolean    @default(true) // Para inativação sem perder histórico

  estabelecimento Estabelecimento       @relation(fields: [estabelecimento_id], references: [id])
  categorias      Categoria[] // Relacionamento N:N implícito no Prisma
  itens_venda     ItemVenda[]
  movimentacoes   MovimentacaoEstoque[] // Histórico de auditoria do produto

  @@map("produtos")
}

model Categoria {
  id                 String @id @default(uuid())
  estabelecimento_id String
  nome               String

  estabelecimento Estabelecimento @relation(fields: [estabelecimento_id], references: [id])
  produtos        Produto[] // Relacionamento N:N implícito no Prisma

  @@map("categorias")
}

model MovimentacaoEstoque {
  id         String             @id @default(uuid())
  produto_id String
  usuario_id String // O responsável pela movimentação
  quantidade Decimal
  tipo       TipoMovimentacao
  motivo     MotivoMovimentacao
  observacao String?
  criado_em  DateTime           @default(now())

  produto Produto @relation(fields: [produto_id], references: [id])
  users   User    @relation(fields: [usuario_id], references: [id])

  @@map("movimentacoes_estoque")
}

// Módulo: PDV & Vendas

model TurnoCaixa {
  id                 String      @id @default(uuid())
  estabelecimento_id String
  usuario_id         String
  valor_abertura     Decimal
  valor_fechamento   Decimal?
  status             StatusTurno @default(ABERTO)
  aberto_em          DateTime    @default(now())
  fechado_em         DateTime?

  estabelecimento Estabelecimento @relation(fields: [estabelecimento_id], references: [id])
  users           User            @relation(fields: [usuario_id], references: [id])
  vendas          Venda[]

  @@map("turnos_caixa")
}

model Venda {
  id                 String          @id @default(uuid())
  estabelecimento_id String
  usuario_id         String // Operador de caixa
  cliente_id         String? // Opcional (Cliente do CRM)
  turno_id           String? // Opcional
  total_venda        Decimal
  metodo_pagamento   MetodoPagamento
  status_pagamento   StatusPagamento @default(PENDENTE)

  // Emissão NFCe "Invisível"
  nfe_status      NfeStatus?
  nfe_url_pdf     String?
  nfe_url_xml     String?
  chave_de_acesso String?

  criada_em DateTime @default(now())

  estabelecimento Estabelecimento @relation(fields: [estabelecimento_id], references: [id])
  users           User            @relation(fields: [usuario_id], references: [id])
  cliente         Cliente?        @relation(fields: [cliente_id], references: [id])
  turno           TurnoCaixa?     @relation(fields: [turno_id], references: [id])
  itens           ItemVenda[]

  @@map("vendas")
}

model ItemVenda {
  id             String  @id @default(uuid())
  venda_id       String
  produto_id     String
  quantidade     Decimal
  preco_unitario Decimal
  subtotal       Decimal

  venda   Venda   @relation(fields: [venda_id], references: [id])
  produto Produto @relation(fields: [produto_id], references: [id])

  @@map("itens_venda")
}
