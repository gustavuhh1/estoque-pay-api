# ─────────────────────────────────────────────────────────────────────────────
# EstoquePay API: variáveis de ambiente.
#
# Copie para `.env` e preencha. O `.env` NUNCA vai para o git (está no
# .gitignore). Em produção os segredos ficam só nos painéis da hospedagem.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────────────────────
# Porta HTTP. A imagem Docker expõe 3333.
PORT=3333
# `development` no dia a dia. A imagem Docker já define `production`.
# ATENÇÃO: em `production` a rota de simulação de Pix NÃO existe (ver
# PAGAMENTO_SIMULACAO_HABILITADA abaixo).
NODE_ENV=development

# ── Banco de dados (PostgreSQL) ──────────────────────────────────────────────
# Rodando a API direto na máquina (npm run dev) contra o Postgres do compose:
DATABASE_URL="postgresql://user:user123@localhost:5432/estoque-db?schema=public"
# Dentro do `docker compose` o host é `db`; o compose já sobrescreve esta
# variável para a API, então não precisa mudar aqui.
#
# Em produção as migrações são aplicadas pelo `docker/entrypoint.sh` com
# `prisma migrate deploy` a cada start (só aplica as pendentes e nunca apaga
# dados). NÃO use `db push` nem `migrate reset` em produção.

# ── Autenticação (better-auth) ───────────────────────────────────────────────
# Segredo que assina as sessões. Gere um valor longo e aleatório:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# URL pública da API (usada pelo better-auth para montar links e callbacks).
BETTER_AUTH_URL="http://localhost:3333"
BASE_URL="http://localhost:3333"
# URL pública do FRONT. Usada nas URLs de retorno do checkout de assinatura.
# (Quando o front e a API ficarem em domínios diferentes, ver a seção
# "Hospedagem" do README: cookie de sessão, CORS e origens confiáveis.)
APP_URL="http://localhost:3000"
# Origens extras aceitas pelo CORS e pelo better-auth, separadas por vírgula. O
# APP_URL já entra sozinho. Em PRODUÇÃO o CORS só aceita estas origens (com
# cookie); fora dela fica aberto para o front de desenvolvimento.
# TRUSTED_ORIGINS="https://app.exemplo.com,https://www.exemplo.com"

# ── Login com Google (SSO) ───────────────────────────────────────────────────
# Opcional. Sem elas o login por e-mail e senha continua funcionando.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-mail transacional (Brevo) ──────────────────────────────────────────────
# Redefinição de senha e convite de funcionário.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="EstoquePay"
# `src/lib/resend.ts` ainda existe; só preencha se for usá-lo.
RESEND_SECRET=

# ── AbacatePay (Pix do PDV e assinatura Premium) ─────────────────────────────
# O projeto roda a AbacatePay em MODO DEV/SANDBOX. Use uma chave `dev`.
# NUNCA coloque aqui uma chave de produção: a rota de simulação de pagamento
# existe só para o modo dev.
ABACATEPAY_API_KEY=
# O mesmo host serve dev e produção; quem decide o ambiente é a chave.
# ABACATEPAY_BASE_URL="https://api.abacatepay.com/v2"
#
# Webhook (uma URL só para Pix e assinatura):
#   POST {BASE_URL}/pagamento/webhook/abacatepay?webhookSecret=<ABACATEPAY_WEBHOOK_SECRET>
# Cadastre essa URL no painel da AbacatePay. O valor abaixo é o `secret` do
# webhook: vai na query string E é aceito como chave do HMAC do corpo.
ABACATEPAY_WEBHOOK_SECRET=
# Opcional. A documentação da AbacatePay é ambígua sobre qual chave assina o
# HMAC (o `secret` do webhook ou uma chave pública global). Se for a pública,
# informe-a aqui; o gateway aceita as duas. Confirmar na primeira entrega real.
ABACATEPAY_WEBHOOK_HMAC_KEY=
# Opcional. Religa a rota POST /pagamento/pix/:id/simular-pagamento quando
# NODE_ENV=production. Só para o ambiente hospedado que usa chave DEV.
# PAGAMENTO_SIMULACAO_HABILITADA=true
