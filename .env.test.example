# Variáveis do `npm test`. Copie para `.env.test`.
#
# ⚠️ O `npm test` roda `prisma migrate reset --force` contra o banco apontado
# aqui, o que APAGA todos os dados dele. Aponte SEMPRE para um banco de teste
# descartável, nunca para o de desenvolvimento nem para produção. O compose
# cria o `estoque-db-test` (ver docker/init-test-db.sh).
DATABASE_URL="postgresql://user:user123@localhost:5432/estoque-db-test?schema=public"
BETTER_AUTH_SECRET=segredo-de-teste
BETTER_AUTH_URL="http://localhost:3333"
BASE_URL="http://localhost:3333"
APP_URL="http://localhost:3000"
NODE_ENV="test"
# As variáveis da AbacatePay para os testes são fixadas no vitest.setup.ts.
